# =================================
# LINE WORKS to Google Calendar Sync
# =================================

# --- Required: LINE WORKS API ---
# Access token for LINE WORKS API
LW_ACCESS_TOKEN=your_access_token_here

# User ID to sync (use "me" for the authenticated user)
LW_USER_ID=me

# --- Required: Google Calendar API ---
# Base64 encoded JSON of Google Service Account credentials
# Generate with: cat service-account.json | base64
GOOGLE_SERVICE_ACCOUNT_JSON_B64=eyJjbGllbnRfZW1haWwiOiIuLi4iLCJwcml2YXRlX2tleSI6Ii4uLiJ9

# Google Calendar ID to sync to
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# --- Required: Security ---
# Secret for authenticating cron requests
CRON_SECRET=your_secure_random_secret_here

# --- Required: Database ---
# Prisma database URL (SQLite)
DATABASE_URL=file:./dev.db

# --- Optional: Sync Configuration ---
# Number of past days to sync (default: 30)
# SYNC_PAST_DAYS=30

# Number of future days to sync (default: 180)
# SYNC_FUTURE_DAYS=180

# Maximum number of events to sync per run (default: 500)
# SYNC_MAX_UPSERT=500
