# LINE WORKS API Settings
LINEWORKS_CLIENT_ID=your_client_id
LINEWORKS_CLIENT_SECRET=your_client_secret
LINEWORKS_SERVICE_ACCOUNT=your_service_account@your_domain
LINEWORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
LINEWORKS_BOT_ID=your_bot_id
LINEWORKS_DOMAIN_ID=your_domain_id
LINEWORKS_TARGET_USER_ID=user_id_to_sync

# Google Calendar API Settings
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Optional: Database path (default: ./data/sync.db)
# DB_PATH=/path/to/sync.db
